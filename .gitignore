.DS_Store
*.swp
*.swo
.idea/
.vscode/

# ── Secrets (never commit) ──────────────────────────────────
dash.token

# ── runtime: generated, large, machine-specific data ────────
runtime/backups/
runtime/logs/
runtime/players/
runtime/worlds/
runtime/command_data/
runtime/resource_packs/
runtime/structures/
runtime/services/
runtime/plugins/
