# ── OS / editor ──────────────────────────────────────────────
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# ── Secrets (never commit) ──────────────────────────────────
dash.token
bambo.conf

# ── runtime: generated, large, machine-specific data ────────
runtime/backups/
runtime/logs/
runtime/players/
runtime/worlds/
runtime/command_data/
runtime/resource_packs/
runtime/structures/
runtime/services/
runtime/plugins/
runtime/*.jar
runtime/*.jar.prev
runtime/bambo.state.json
runtime/.bambo.lock
runtime/.bambo.intentional-stop
runtime/server.lock
runtime/pnx.yml
runtime/ops.txt
runtime/white-list.txt
runtime/banned-ips.json
runtime/banned-players.json
runtime/pnx.yml.pre-apply-*
runtime/.trash/
# The server identity keypair and the undo copies 'restore'/'world delete' leave
# behind. Both were missing here, which is how a private key and a whole world
# snapshot ended up committed in v2.5.3.
runtime/keys/
runtime/*.pre-restore-*/
runtime/*.stale-*

# ── project logs (build/cron/dashboard/watchdog) ─────────────
logs/*
!logs/.gitkeep
# crontab snapshots written by `install.sh` and `bambo maintenance on`. Not
# ignored here once, which is how one got committed in October; they hold the
# absolute paths and schedules of whichever machine ran the install.
backups/

# ── third-party downloaded reference (kept as its own repo) ─
forks/

# ── java build output / bytecode ────────────────────────────
empty-serve/out/
**/__pycache__/
*.pyc

# ── local tool state ────────────────────────────────────────
.qoder/
