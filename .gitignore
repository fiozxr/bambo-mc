runtime/*.jar.prev
runtime/bambo.state.json
runtime/.bambo.lock
runtime/.bambo.intentional-stop
runtime/server.lock
runtime/pnx.yml
runtime/ops.txt
runtime/white-list.txt
runtime/banned-ips.json
runtime/banned-players.json
runtime/pnx.yml.pre-apply-*

# ── project logs (build/cron/dashboard/watchdog) ─────────────
logs/*
!logs/.gitkeep

# ── third-party downloaded reference (kept as its own repo) ─
forks/

# ── java build output / bytecode ────────────────────────────
empty-serve/out/
**/__pycache__/
*.pyc

# ── local tool state ────────────────────────────────────────
.qoder/
