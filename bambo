# ---- world trash (undo for deleted worlds) ----
world_trash_list() {
  local any=0 e
  for e in "$SRV/.trash/worlds"/*/; do
    [ -d "$e" ] || continue
    any=1
    echo "  $(basename "$e")"
  done
  [ "$any" = 0 ] && echo "  (no trashed worlds)" || true
}
world_trash_resolve() {
  # resolves a user-supplied name to the single matching trash entry
  local want="$1" e name matches=""
  for e in "$SRV/.trash/worlds"/*/; do
    [ -d "$e" ] || continue
    name="$(basename "$e")"
    if [ "$name" = "$want" ] || [[ "$name" == *"-$want" ]]; then
      matches="$matches $name"
    fi
  done
  matches="${matches# }"
  case "$(echo "$matches" | wc -w)" in
    0) return 1 ;;
    1) echo "$matches" ;;
    *) echo "__ambiguous__" ;;
  esac
}
world_trash_restore() {
  local want="$1" entry name stamp
  [ -n "$want" ] || die "usage: bambo world trash restore <id|name>"
  entry="$(world_trash_resolve "$want")" || die "no trashed world matches '$want' (list: bambo world trash list)"
  [ "$entry" = "__ambiguous__" ] && die "multiple trashed worlds match '$want' - use the full trash id"
  stamp="${entry:0:15}"; name="${entry:16}"
  lock_acquire; world_require_stopped
  world_exists "$name" && { lock_release; die "world '$name' already exists - delete/rename it first"; }
  mv "$SRV/.trash/worlds/$entry" "$SRV/worlds/$name" || { lock_release; die "restore failed"; }
  lock_release
  echo "restored world '$name' from trash ($entry)"
}
world_trash_purge() {
  local want="$1" entry
  [ -n "$want" ] || die "usage: bambo world trash purge <id>"
  entry="$(world_trash_resolve "$want")" || die "no trashed world matches '$want'"
  [ "$entry" = "__ambiguous__" ] && die "multiple matches - use the full trash id"
  lock_acquire
  rm -rf "$SRV/.trash/worlds/$entry" || { lock_release; die "purge failed"; }
  lock_release
  echo "permanently deleted trashed world $entry"
}
world_trash() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list) world_trash_list ;;
    restore) world_trash_restore "$1" ;;
    purge) world_trash_purge "$1" ;;
    *) die "world trash: use list|restore|purge" ;;
  esac
}

# ---- client-version detection + matching-server choice (installer / setup) ----
client_detect() {
  # Best-effort detection of a locally installed Bedrock client version (Linux
  # launcher caches). Returns e.g. "1.26.60" or "" when unknown. Override with
  # BAMBO_CLIENT_VERSION.
  local v="" d f
  v="${BAMBO_CLIENT_VERSION:-}"
  if [ -z "$v" ]; then
    for d in "$HOME/.local/share/mcpelauncher" "$HOME/.mcpelauncher" "$HOME/.cache/mcpelauncher"; do
      [ -d "$d" ] || continue
      for f in "$d"/versions/*.json "$d"/*version*.json "$d"/data/*.json; do
        [ -f "$f" ] || continue
        v="$(grep -hoE '"version"[[:space:]]*:[[:space:]]*"[0-9]+\.[0-9]+\.[0-9]+' "$f" 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')"
        [ -n "$v" ] && break
      done
      [ -n "$v" ] && break
    done
  fi
  echo "$v"
}
client_to_pnx() {
  # map a Bedrock client version to the matching PNX release tag ("" = unknown)
  case "$1" in
    1.26.60*) echo "3.0.6" ;;
    1.26.50*) echo "3.0.5" ;;
    1.26.45*) echo "3.0.4" ;;
    1.26.44*) echo "3.0.3" ;;
    *) echo "" ;;
  esac
}
setup_choose() {
  if [ ! -t 0 ]; then
    die "setup --ask needs an interactive terminal (use plain 'bambo setup' for defaults)"
  fi
  local detected tag want ans
  detected="$(client_detect)"
  echo "client version detected: ${detected:-unknown}"
  if [ -n "$detected" ]; then
    tag="$(client_to_pnx "$detected")"
  fi
  if [ -n "$tag" ]; then
    printf 'Install matching server PNX %s (protocol %s)? [Y/n] ' "$tag" "$(pnx_facts "$tag" | cut -d'|' -f1)"
    read -r ans || true
    case "${ans:-y}" in
      y|Y|"") want="$tag" ;;
      *) want="" ;;
    esac
  else
    printf 'No known server matches version %s. Install latest stable? [Y/n] ' "${detected:-detected}"
    read -r ans || true
    case "${ans:-y}" in
      y|Y|"") want="" ;;
      *) die "cancelled by user" ;;
    esac
  fi
  if [ -n "$want" ]; then
    echo "installing PNX $want (matches client $detected)..."
    setup "$want"
  else
    echo "installing latest stable PNX..."
    setup
  fi
}

# ---- webhook notifications (optional; enabled by BAMBO_WEBHOOK_URL) ----
setup_menu() {
  [ -t 0 ] || die "version menu needs an interactive terminal (use plain 'bambo setup' for latest)"
  local detected tag ans custom
  detected="$(client_detect)"
  echo
  echo "Which server version do you want to install?"
  echo "  1) Latest stable (fetched from GitHub)"
  if [ -n "$detected" ]; then
    tag="$(client_to_pnx "$detected")"
    if [ -n "$tag" ]; then
      echo "  2) Match your client ($detected -> PNX $tag, protocol $(pnx_facts "$tag" | cut -d'|' -f1))"
    else
      echo "  2) Match your client ($detected -> no known server release)"
    fi
  else
    echo "  2) Match your client (none detected on this machine)"
  fi
  echo "  3) PNX 3.0.6 (Bedrock 1.26.60, protocol 2225)"
  echo "  4) PNX 3.0.5 (Bedrock 1.26.50, protocol 2193)"
  echo "  5) PNX 3.0.4 (Bedrock 1.26.45, protocol 2169)"
  echo "  6) PNX 3.0.3 (Bedrock 1.26.44, protocol 2168)"
  echo "  7) Another release (type a tag, e.g. 3.0.2)"
  echo "  (Enter) Latest stable"
  printf 'Your choice [1]: '
  read -r ans || true
  case "${ans:-1}" in
    2)
      if [ -n "$tag" ]; then
        echo "installing PNX $tag (matches client $detected)..."
        setup "$tag"
      else
        echo "no matching release known for $detected - installing latest stable"
        setup
      fi
      ;;
    3) setup 3.0.6 ;;
    4) setup 3.0.5 ;;
    5) setup 3.0.4 ;;
    6) setup 3.0.3 ;;
    7)
      printf 'PNX release tag (e.g. 3.0.2): '
      read -r custom || true
      [[ "$custom" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "invalid tag '$custom'"
      setup "$custom"
      ;;
    *) echo "installing latest stable PNX..."; setup ;;
  esac
}
notify() {
  local event="$1" summary="${2:-}"
  local url; url="$(cfg_val BAMBO_WEBHOOK_URL)"
  [ -n "$url" ] || return 0
  command -v curl >/dev/null 2>&1 || return 0
  curl -fsS --max-time 10 -H 'content-type: application/json' \
    -d "$(python3 -c 'import json,sys;print(json.dumps({"text": sys.argv[1], "service":"bambo-mc", "event": sys.argv[2], "version": sys.argv[3]}))' "$summary" "$event" "$BAMBO_VERSION")" \
    "$url" >/dev/null 2>&1 || warn "webhook delivery failed for $event"
}

# ---- upstream update awareness ----
update_choose() {
  local detected tag ans
  detected="$(client_detect)"
  echo "client version detected: ${detected:-unknown}"
  tag="$(client_to_pnx "$detected")"
  if [ -n "$tag" ]; then
    printf 'Upgrade to matching PNX %s (protocol %s)? [Y/n] ' "$tag" "$(pnx_facts "$tag" | cut -d'|' -f1)"
    read -r ans || true
    case "${ans:-y}" in
      y|Y|"") echo "$tag" ;;
      *) echo "" ;;
    esac
  else
    printf 'No known server matches version %s. Keep upgrading to latest stable? [Y/n] ' "${detected:-detected}"
    read -r ans || true
    case "${ans:-y}" in
      n|N) die "cancelled by user" ;;
    esac
    echo ""
  fi
}
update() {
  local sub="${1:-check}" ask=0 want=""
  case "$sub" in
    ask|--ask) ask=1; sub=apply ;;
  esac
  case "$sub" in
    check)
      local current latest
      current="$(state_get tag)"
      echo "installed: PNX ${current:-<none>}"
      if [ "${BAMBO_UPDATE_OFFLINE:-0}" = 1 ]; then
        echo "upstream: skipped (BAMBO_UPDATE_OFFLINE=1)"
        echo "status: run 'bambo update check' with network to compare"
        return 0
      fi
      command -v curl >/dev/null 2>&1 || { echo "upstream: curl missing"; return 0; }
      if ! latest="$(curl -fsS --max-time 20 https://api.github.com/repos/PowerNukkitX/PowerNukkitX/releases/latest \
           | python3 -c 'import sys,json; print(json.load(sys.stdin)["tag_name"])' 2>/dev/null)"; then
        echo "upstream: unreachable (offline?) - no comparison"
        return 0
      fi
      echo "upstream: PNX $latest"
      if [ "$current" = "$latest" ]; then
        echo "status: up to date"
      else
        echo "status: UPDATE AVAILABLE - run 'bambo update apply' (or 'bambo update --ask')"
      fi
      ;;
    apply)
      if [ "$ask" = 1 ]; then
        [ -t 0 ] || die "update --ask needs an interactive terminal (use 'bambo update apply' for latest)"
        want="$(update_choose)"
      fi
      local was_up=0
      is_up && was_up=1
      [ -f "$JAR" ] || { echo "no server jar yet - fetching + installing..."; setup ${want:+$want}; return 0; }
      if [ "$was_up" = 1 ]; then
        echo "stopping server for safe upgrade..."
        stop
      fi
      backup || { warn "backup failed - aborting update"; [ "$was_up" = 1 ] && start; return 1; }
      setup ${want:+$want} || { warn "setup failed - server left on the previous version"; [ "$was_up" = 1 ] && start; return 1; }
      notify update "server upgraded to PNX $(state_get tag)"
      if [ "$was_up" = 1 ]; then
        echo "restarting server..."
        start
      else
        echo "server was stopped; start it with 'bambo start' when ready."
      fi
      ;;
    *) die "update: use check|apply|--ask" ;;
  esac
}

# ---- scheduled daily restart (cron-managed maintenance) ----
maintenance() {
  local sub="${1:-status}"
  local line="0 4 * * * cd \"$ROOT\" && ./bambo restart >> \"$ROOT/logs/maintenance.log\" 2>&1"
  case "$sub" in
    status)
      if crontab -l 2>/dev/null | grep -qF "bambo restart"; then
        echo "daily auto-restart: ON (04:00)"
      else
        echo "daily auto-restart: OFF"
      fi
      ;;
    on)
      crontab -l 2>/dev/null | grep -qF "bambo restart" && { echo "daily auto-restart already ON"; return 0; }
      mkdir -p "$ROOT/backups" "$ROOT/logs"
      local stamp; stamp="$(date +%Y%m%d-%H%M%S)"
      crontab -l 2>/dev/null > "$ROOT/backups/crontab.backup.$stamp" || true
      { crontab -l 2>/dev/null; echo "$line"; } | crontab -
      echo "daily auto-restart enabled (04:00); previous crontab saved to backups/crontab.backup.$stamp"
      ;;
    off)
      crontab -l 2>/dev/null | grep -qF "bambo restart" || { echo "daily auto-restart already OFF"; return 0; }
      crontab -l 2>/dev/null | grep -vF "bambo restart" | crontab -
      echo "daily auto-restart disabled"
      ;;
    *) die "maintenance: use status|on|off" ;;
  esac
}

