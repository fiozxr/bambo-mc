# ---- config: safe, comment-preserving editing of pnx.yml (python3, stdlib) ----
PNX_CONFIG_KEYS="motd sub-motd maxPlayers xboxAuth allowList difficulty gamemode viewDistance pvp enableMetrics language defaultLevelName"

config_edit() {
  # config_edit <file> <key> <value>   (rewrites one key; preserves everything else)
  command -v python3 >/dev/null || die "config needs python3"
  ESX_CFG_FILE="$1" ESX_CFG_KEY="$2" ESX_CFG_VAL="$3" python3 - <<'PY' || die "failed to edit $2 in $1"
import os, re
path = os.environ["ESX_CFG_FILE"]; key = os.environ["ESX_CFG_KEY"]; val = os.environ["ESX_CFG_VAL"]
# yaml-quote only when the value is not a plain safe token (numbers/bools/words)
def esc(v):
    if re.fullmatch(r"[A-Za-z0-9_.:+/-]+", v):
        return v
    return '"' + v.replace("\\", "\\\\").replace('"', '\\"') + '"'
pat = re.compile(r"^(\s*)" + re.escape(key) + r"\s*:")
out, hit = [], False
for line in open(path, encoding="utf-8"):
    m = pat.match(line)
    if m:
        out.append(m.group(1) + key + ": " + esc(val) + "\n"); hit = True
    else:
        out.append(line)
if not hit:
    raise SystemExit(1)
tmp = path + ".tmp"
open(tmp, "w", encoding="utf-8").writelines(out)
os.replace(tmp, path)
PY
}

config_get() {
  local key="$1"
  case " $PNX_CONFIG_KEYS " in
    *" $key "*) ;;
    *) die "config: unknown key '$key'. known: $PNX_CONFIG_KEYS" ;;
  esac
  grep -E "^\\s*${key}\\s*:" "$SRV/pnx.yml" 2>/dev/null | head -1 || echo "($key not set)"
}

config_diff() {
  command -v python3 >/dev/null || die "config needs python3"
  [ -f "$SRV/pnx.yml" ] && [ -f "$ROOT/server/pnx.yml" ] || { echo "(template or live config missing)"; return 1; }
  ESX_TEMPLATE="$ROOT/server/pnx.yml" ESX_LIVE="$SRV/pnx.yml" python3 - <<'PY'
import os, re
def kv(path):
    d = {}
    for line in open(path, encoding="utf-8"):
        m = re.match(r"^\s*([A-Za-z0-9_-]+)\s*:\s*(.*?)\s*$", line)
        if m and m.group(1) not in d:
            d[m.group(1)] = m.group(2)
    return d
t, l = kv(os.environ["ESX_TEMPLATE"]), kv(os.environ["ESX_LIVE"])
keys = [k for k in t if k in l and t[k] != l[k]] + [k for k in l if k not in t]
for k in sorted(set(keys)):
    print(f"  {k}: template={t.get(k,'<absent>')!r} live={l.get(k,'<absent>')!r}")
if not keys:
    print("  (no drift between template and live config)")
PY
}

config_apply_template() {
  # one-way: tracked template -> live config (destructive to local changes)
  [ -f "$ROOT/server/pnx.yml" ] || die "template missing: $ROOT/server/pnx.yml"
  is_up && die "server is running - stop it first (bambo stop)"
  local stamp; stamp="$(date +%Y%m%d-%H%M%S)"
  cp -a "$SRV/pnx.yml" "$SRV/pnx.yml.pre-apply-$stamp" 2>/dev/null || true
  cp -a "$ROOT/server/pnx.yml" "$SRV/pnx.yml"
  echo "applied template -> runtime/pnx.yml (previous config kept as pnx.yml.pre-apply-$stamp)"
  config_diff
}

