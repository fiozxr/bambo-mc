config_set_conf() {
  # edits bambo.conf (KEY=value lines), preserving comments/order; updates the
  # in-shell value too, so a same-invocation 'apply' sees the new setting
  local key="$1" val="$2"
  case " $CONFIG_KEYS " in
    *" $key "*) ;;
    *) die "config: unknown key '$key'. known keys: $CONFIG_KEYS" ;;
  esac
  command -v python3 >/dev/null || die "config needs python3"
  [ -f "$CONF" ] || config_init
  ESX_CONF="$CONF" ESX_KEY="$key" ESX_VAL="$val" python3 - <<'PY' || die "failed to set $key in $CONF"
import os, re
path = os.environ["ESX_CONF"]; key = os.environ["ESX_KEY"]; val = os.environ["ESX_VAL"]
pat = re.compile(r"^(\s*)" + re.escape(key) + r"(?:\s*=\s*.*)?$")
out, hit = [], False
for line in open(path, encoding="utf-8"):
    if pat.match(line):
        out.append(key + "=" + val + "\n"); hit = True
    else:
        out.append(line)
if not hit:
    out.append("\n" + key + "=" + val + "\n")
tmp = path + ".tmp"
open(tmp, "w", encoding="utf-8").writelines(out)
os.chmod(tmp, 0o600)
os.replace(tmp, path)
PY
  export "$key=$val"
}
cfg_check() {
  local k v b
  for k in BAMBO_XBOX_AUTH BAMBO_ALLOWLIST BAMBO_PVP BAMBO_ENABLE_METRICS; do
    v="$(cfg_val "$k")"; b="$(norm_bool "$v")"
    [ -n "$b" ] || die "$k must be true/false (got '$v')"
  done
  v="$(cfg_val BAMBO_MAX_PLAYERS)"
  [[ "$v" =~ ^[0-9]+$ ]] && [ "$v" -ge 1 ] && [ "$v" -le 1000 ] || die "BAMBO_MAX_PLAYERS must be a number 1..1000 (got '$v')"
  v="$(cfg_val BAMBO_DIFFICULTY)"
  [[ "$v" =~ ^[0-3]$ ]] || die "BAMBO_DIFFICULTY must be 0..3 (got '$v')"
  v="$(cfg_val BAMBO_GAMEMODE)"
  [[ "$v" =~ ^[0-3]$ ]] || die "BAMBO_GAMEMODE must be 0..3 (got '$v')"
  v="$(cfg_val BAMBO_VIEW_DISTANCE)"
  [[ "$v" =~ ^[0-9]+$ ]] && [ "$v" -ge 2 ] && [ "$v" -le 32 ] || die "BAMBO_VIEW_DISTANCE must be 2..32 (got '$v')"
}
config_deploy_key() {
  # config_deploy_key <BAMBO_KEY> <pnx_key> [bool]
  local ck="$1" pk="$2" isbool="${3:-}" v
  v="$(cfg_val "$ck")"
  [ -n "$isbool" ] && v="$(norm_bool "$v")"
  config_edit "$SRV/pnx.yml" "$pk" "$v" || die "failed to write $pk to runtime/pnx.yml"
}
config_apply() {
  local restart=0
  [ "${1:-}" = "--restart" ] && restart=1
  cfg_check
  [ -f "$SRV/pnx.yml" ] || die "missing $SRV/pnx.yml - configure the server first (bambo setup)"
  config_deploy_key BAMBO_SERVER_NAME motd
  config_deploy_key BAMBO_SUB_NAME sub-motd
  config_deploy_key BAMBO_MAX_PLAYERS maxPlayers
  config_deploy_key BAMBO_XBOX_AUTH xboxAuth bool
  config_deploy_key BAMBO_ALLOWLIST allowList bool
  config_deploy_key BAMBO_DIFFICULTY difficulty
  config_deploy_key BAMBO_GAMEMODE gamemode
  config_deploy_key BAMBO_VIEW_DISTANCE viewDistance
  config_deploy_key BAMBO_PVP pvp bool
  config_deploy_key BAMBO_ENABLE_METRICS enableMetrics bool
  echo "applied configuration -> runtime/pnx.yml"
  if [ "$restart" = 1 ] && is_up; then
    echo "restarting server to apply..."
    stop; start
  elif [ "$restart" = 1 ]; then
    echo "server is stopped - start it with 'bambo start' when ready."
  fi
}
config_wizard() {
  local applynow=0 defaults=0 a
  for a in "$@"; do
    case "$a" in
      --apply) applynow=1 ;;
      --defaults) defaults=1 ;;
      *) die "wizard: unknown option '$a'" ;;
    esac
  done
  if [ "$defaults" = 0 ] && [ ! -t 0 ]; then
    die "wizard needs an interactive terminal (or run 'bambo config wizard --defaults')"
  fi
  command -v python3 >/dev/null || die "wizard needs python3"
  [ -f "$CONF" ] || config_init
  ESX_CONF="$CONF" ESX_DEFAULTS="$defaults" python3 - <<'PY' || die "wizard failed"
import os, re, sys
path = os.environ["ESX_CONF"]; defaults = os.environ["ESX_DEFAULTS"] == "1"
cur = {}
try:
    for line in open(path, encoding="utf-8"):
        m = re.match(r"^\s*([A-Za-z0-9_]+)\s*=\s*(.*?)\s*$", line)
        if m:
            cur[m.group(1)] = m.group(2)
except Exception:
    pass
QS = [
    ("BAMBO_SERVER_NAME", "Server name shown in the client list", "bambo-mc"),
    ("BAMBO_SUB_NAME", "Subtitle under the server name", "family server"),
    ("BAMBO_MAX_PLAYERS", "Maximum number of players (1-1000)", "20"),
    ("BAMBO_XBOX_AUTH", "Require Xbox Live sign-in? (true/false)", "false"),
    ("BAMBO_ALLOWLIST", "Enable whitelist/allowlist? (true/false)", "false"),
    ("BAMBO_DIFFICULTY", "Difficulty 0=peaceful 1=easy 2=normal 3=hard", "1"),
    ("BAMBO_GAMEMODE", "Default gamemode 0=survival 1=creative 2=adventure 3=spectator", "0"),
    ("BAMBO_VIEW_DISTANCE", "View distance in chunks (2-32)", "8"),
    ("BAMBO_PVP", "Allow PvP? (true/false)", "true"),
    ("BAMBO_ENABLE_METRICS", "Send anonymous metrics upstream? (true/false)", "false"),
    ("BAMBO_HEAP", "JVM heap size (e.g. 1536M)", "1536M"),
    ("BAMBO_KEEP", "Number of backups to keep", "10"),
    ("BAMBO_DASH_HOST", "Dashboard listen address (127.0.0.1 = local only)", "127.0.0.1"),
    ("BAMBO_DASH_PORT", "Dashboard port", "8787"),
]
lines = []
for k, q, d in QS:
    prev = cur.get(k, d)
    if defaults:
        val = prev
    else:
        sys.stdout.write("  %s [%s]: " % (q, prev)); sys.stdout.flush()
        val = sys.stdin.readline().strip()
        if not val:
            val = prev
    lines.append(k + "=" + val)
open(path, "w", encoding="utf-8").write("\n".join(lines) + "\n")
os.chmod(path, 0o600)
PY
  echo "configuration written to $CONF"
  if [ "$applynow" = 1 ]; then
    config_apply --restart
  else
    echo "run 'bambo config apply' to deploy it to the server."
  fi
}

config() {
  case "${1:-show}" in
    init)  config_init "${2:-}" ;;
    show|list) config_show ;;
    set)   [ $# -ge 3 ] || die "usage: bambo config set <key> <value>"
           config_set_conf "$2" "$3"
           echo "config: $2 = $3  (run 'bambo config apply' to deploy)" ;;
    apply) config_apply "${2:-}" ;;
    apply-template) config_apply_template ;;
    wizard) config_wizard "${@:2}" ;;
    get)   config_get "${2:-motd}" ;;
    diff)  config_diff ;;
    *)     die "config: use init|show|set|apply|apply-template|wizard|get|diff" ;;
  esac
}

motd() {
  if [ "${1:-}" = "--show" ] || [ $# -eq 0 ]; then
    echo "current server name: $(cfg_val BAMBO_SERVER_NAME)  /  $(cfg_val BAMBO_SUB_NAME)"
    [ $# -eq 0 ] && echo "usage: bambo motd \"<name>\" [\"<sub-name>\"]"
    return 0
  fi
  config_set_conf BAMBO_SERVER_NAME "$1"
  [ $# -ge 2 ] && config_set_conf BAMBO_SUB_NAME "$2"
  echo "updated config; deploying and restarting..."
  config_apply --restart
}
backup() {
  local force="${1:-}"
  local keep="${BAMBO_KEEP:-10}"
  local dir="$SRV/backups"
  local ts; ts="$(date +%Y%m%d-%H%M%S)"
  local dest="$dir/$ts"
  mkdir -p "$dir"
  lock_acquire

  if tmux has-session -t "$SESSION" 2>/dev/null && [ "$force" != "--force" ]; then
    lock_release
    echo "server is RUNNING - worlds/ is a live LevelDB (db/LOCK), so copying it mid-write"
    echo "can produce a snapshot that refuses to open."
    echo "safest: ./bambo stop && ./bambo backup"
    echo "or accept the risk with: ./bambo backup --force"
    return 1
  fi
  tmux has-session -t "$SESSION" 2>/dev/null && echo "WARNING: snapshotting a running server - this copy may be unusable"

  # return, never die(): in "stop && backup && start" an exit here would leave the server down
  if [ ! -d "$SRV/worlds" ]; then
    echo "nothing to back up: no $SRV/worlds"; lock_release; return 0
  fi
  mkdir -p "$dest" || { lock_release; die "cannot write to $dir"; }
  cp -a "$SRV/worlds"  "$dest/worlds"  || { rm -rf "$dest"; lock_release; die "copy failed"; }
  [ -d "$SRV/players" ] && cp -a "$SRV/players" "$dest/players"
  cp -a "$SRV/pnx.yml" "$dest/pnx.yml"

  # manifest + integrity check
  local cur dbf
  dbf="$dest/worlds/world/db"
  cur=""
  [ -f "$dbf/CURRENT" ] && cur="$(cat "$dbf/CURRENT" 2>/dev/null)"
  {
    echo "{"
    echo "  \"created_utc\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\","
    echo "  \"tool_version\": \"$BAMBO_VERSION\","
    echo "  \"server\": \"$(state_get tag)\","
    echo "  \"worlds\": {\"world\": {\"db_current\": \"$cur\"}},"
    echo "  \"backup_dir\": \"$dir\""
    echo "}"
  } > "$dest/manifest.json"

  local ok=1
  if [ -n "$cur" ] && [ ! -f "$dbf/$cur" ]; then
    echo "  WARNING: CURRENT=$cur but $cur is missing - snapshot may be incomplete"; ok=0
  fi
  local wc; wc="$(find "$dest/worlds" -type f | wc -l)"
  echo "  snapshot $ts: $(du -sh "$dest" | cut -f1), $wc files"
  [ "$ok" = 1 ] && echo "  integrity: OK (CURRENT -> $cur exists)"
  notify backup "snapshot $ts created ($(du -sh "$dest" | cut -f1))"

  # retention: keep the newest $keep snapshots
  # retention: keep the newest $keep snapshots
  local old
  old="$(find "$dir" -maxdepth 1 -mindepth 1 -type d -name '[0-9][0-9]*' \
         -printf '%T@ %p\n' 2>/dev/null | sort -rn | tail -n +$((keep+1)) | cut -d' ' -f2-)"
  if [ -n "$old" ]; then
    echo "  pruning $(echo "$old" | wc -l) snapshot(s) older than retention ($keep)"
    while IFS= read -r p; do
      [ -n "$p" ] && rm -rf "$p"
    done <<< "$old"
  fi
  lock_release
  if [ -n "$old" ]; then
    echo "  pruning $(echo "$old" | wc -l) snapshot(s) older than retention ($keep)"
    rm -rf $old
  fi
  lock_release
}

restore() {
  local which="${1:-list}"
  local dir="$SRV/backups"
  if [ "$which" = "list" ] || [ -z "$which" ]; then
    if [ -d "$dir" ]; then
      echo "snapshots in $dir:"
      for d in $(ls -1d "$dir"/[0-9]* 2>/dev/null | sort -r); do
        echo "  $(basename "$d")   $(du -sh "$d" | cut -f1)   $( [ -f "$d/manifest.json" ] && echo manifest || echo no-manifest)"
      done
    else
      echo "(no backups yet)"
    fi
    return 0
  fi
  local src="$dir/$which"
  [ -d "$src/worlds" ] || die "no such backup: $which (./bambo restore list)"
  lock_acquire
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    lock_release
    die "server is running - ./bambo stop first, or the live store will overwrite the restore"
  fi
  local stamp; stamp="$(date +%Y%m%d-%H%M%S)"
  mv "$SRV/worlds"  "$SRV/worlds.pre-restore-$stamp"  && echo "  kept current worlds as worlds.pre-restore-$stamp"
  if [ -d "$src/players" ] && [ -d "$SRV/players" ]; then
    mv "$SRV/players" "$SRV/players.pre-restore-$stamp" && cp -a "$src/players" "$SRV/players"
  fi
  cp -a "$src/worlds" "$SRV/worlds" || { lock_release; die "restore copy failed - your data is still in worlds.pre-restore-$stamp"; }
  [ -f "$src/pnx.yml" ] && cp -a "$src/pnx.yml" "$SRV/pnx.yml"
  lock_release
  echo "restored $which. ./bambo start to verify, then delete worlds.pre-restore-$stamp if all is well."
}
# version facts for known PNX releases (protocol / client version). Kept in sync
# with docs/VERSIONS.md; unknown tags record the tag only.
pnx_facts() {
  case "$1" in
    3.0.6) echo "2225|1.26.60" ;;
    3.0.5) echo "2193|1.26.50" ;;
    3.0.4) echo "2169|1.26.45" ;;
    3.0.3) echo "2168|1.26.44" ;;
    3.0.2) echo "2168|unknown" ;;
    3.0.0|3.0.1) echo "1001|unknown" ;;
    *) echo "|" ;;
  esac
}

setup() {
  # ./bambo setup              -> newest stable release
  # ./bambo setup 3.0.4        -> a specific release (this is how you roll back when
  #                              a Bedrock update outruns PNX: pick the build whose
  #                              "Minecraft Version" matches your clients)
  local want="${1:-}" api="https://api.github.com/repos/PowerNukkitX/PowerNukkitX"
  local -a prev_args=()
  command -v python3 >/dev/null || die "setup needs python3 to read the release API"
  lock_acquire

  local endpoint="$api/releases/latest"; [ -n "$want" ] && endpoint="$api/releases/tags/$want"
  local meta rc=0
  meta="$(curl -fsS --max-time 30 "$endpoint" 2>/dev/null | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
assets = [a for a in d.get('assets', []) if a['name'].endswith('.jar')]
if not assets:
    sys.exit(1)
a = assets[0]
print(d['tag_name'] + '|' + a['browser_download_url'] + '|' + (a.get('digest') or '') + '|' + str(a['size']))
" 2>/dev/null)" || rc=$?
  if [ $rc -ne 0 ] || [ -z "$meta" ]; then
    [ -n "$want" ] && echo "bambo: no release tag '$want'. Known ones:" && \
      curl -fsS --max-time 30 "$api/releases" | python3 -c "
import sys,json
for r in json.load(sys.stdin): print('  ', r['tag_name'], r['published_at'][:10])" 2>/dev/null
    lock_release
    die "could not read the GitHub release API${want:+ for '$want'}"
  fi
  local tag url digest size
  IFS='|' read -r tag url digest size <<<"$meta"
  digest="${digest#sha256:}"
  echo "target: PNX $tag  ($((size/1048576)) MB)"

  if [ -f "$JAR" ] && [ "$(stat -c%s "$JAR")" = "$size" ] \
     && [ "$(sha256sum "$JAR" | cut -d' ' -f1)" = "$digest" ]; then
    echo "  already present and verified: $JAR"
  else
    echo "  resume is on (-C -) and HTTP/1.1 is forced - HTTP/2 streams died mid-transfer"
    echo "  on this link yesterday, so a stall aborts and retries instead of hanging."
    curl -fL --http1.1 --retry 10 --retry-delay 5 -C - \
         --speed-limit 2048 --speed-time 120 --max-time 7200 \
         --progress-bar -o "$JAR.part" "$url" || { lock_release; die "download failed - rerun ./bambo setup to resume"; }

    local got; got="$(sha256sum "$JAR.part" | cut -d' ' -f1)"
    if [ -n "$digest" ] && [ "$got" != "$digest" ]; then
      rm -f "$JAR.part"
      lock_release
      die "sha256 mismatch (got ${got:0:16}..., want ${digest:0:16}...) - partial deleted, rerun to resume"
    fi
    # preserve the previous jar AND its facts: the state_write below overwrites
    # tag/sha256/protocol with the new jar, and without the old values recorded
    # there is nothing for 'bambo rollback --prev' to restore the state from.
    if [ -f "$JAR" ]; then
      prev_args=("prev_tag=$(state_get tag)" "prev_sha256=$(state_get sha256)"
                 "prev_protocol=$(state_get protocol)" "prev_client_version=$(state_get client_version)"
                 "prev_size=$(stat -c%s "$JAR" 2>/dev/null || echo 0)")
      mv -f "$JAR" "$JAR_PREV"
      echo "  previous jar kept as $(basename "$JAR_PREV")"
    fi
    mv "$JAR.part" "$JAR"
    echo "  verified sha256 $got"
  fi

  # record the pinned deployment facts
  local proto client
  IFS='|' read -r proto client <<<"$(pnx_facts "$tag")"
  state_write "tag=$tag" "sha256=$digest" "size=$size" "protocol=$proto" "client_version=$client" "installed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
              ${prev_args[@]+"${prev_args[@]}"}
  echo "  recorded state: tag=$tag protocol=$proto client=$client"
  echo "next: ./bambo stop && ./bambo backup   (back up before swapping server versions)"
  echo "      ./bambo start"
  lock_release
}

# ---- version rollback: offline prev restore / choose a release (menu or direct) ----
rollback_list() {
  local cur prevtag
  cur="$(state_get tag)"
  echo "current      : PNX ${cur:-<none>}   ($( [ -f "$JAR" ] && du -sh "$JAR" | cut -f1 || echo 'no jar'))"
  prevtag="$(state_get prev_tag)"
  if [ -f "$JAR_PREV" ] && [ -n "$prevtag" ]; then
    echo "previous     : PNX $prevtag (protocol $(state_get prev_protocol), client $(state_get prev_client_version)) - offline restore available"
  elif [ -f "$JAR_PREV" ]; then
    echo "previous     : jar present (facts not recorded) - offline restore available"
  fi
  echo
  echo "known releases (download required):"
  local t pf
  for t in 3.0.6 3.0.5 3.0.4 3.0.3 3.0.2 3.0.0 3.0.1; do
    pf="$(pnx_facts "$t")"
    printf '  %-8s Bedrock %-9s protocol %s\n' "$t" "${pf#*|}" "${pf%|*}"
  done
}
rollback_do() {
  local target="${1:-}" want="" was_up=0
  [ -n "$target" ] || die "usage: bambo rollback <version|--prev|--list>"
  if [ "$target" = "--prev" ]; then
    [ -f "$JAR_PREV" ] || die "no previous jar found (nothing to roll back to offline)"
    want=prev
  else
    want="$(client_to_pnx "$target")"
    [ -z "$want" ] && [[ "$target" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && want="$target"
    [ -n "$want" ] || die "unknown version '$target' (see: bambo rollback --list)"
  fi
  [ "$want" != "prev" ] && [ "$want" = "$(state_get tag)" ] && { echo "already on PNX $want"; return 0; }

  is_up && was_up=1
  # backup/setup/start/stop report fatal errors with die(), which EXITS - so each is
  # run in a subshell here; called directly, a failure would kill the process and
  # leave the server stopped with these recovery branches never reached.
  if [ "$was_up" = 1 ]; then echo "stopping server..."; ( stop ); fi
  ( backup ) || { warn "backup failed - aborting rollback"; [ "$was_up" = 1 ] && ( start ); return 1; }

  if [ "$want" = "prev" ]; then
    local ptag psha pproto pclient psize ctag csha cproto cclient csize
    ptag="$(state_get prev_tag)"; psha="$(state_get prev_sha256)"
    pproto="$(state_get prev_protocol)"; pclient="$(state_get prev_client_version)"
    psize="$(state_get prev_size)"
    if [ -z "$ptag" ]; then
      warn "the previous jar has no recorded version (installed before this was tracked) - pick a release: bambo rollback --list"
      [ "$was_up" = 1 ] && ( start )
      return 1
    fi
    ctag="$(state_get tag)"; csha="$(state_get sha256)"; cproto="$(state_get protocol)"
    cclient="$(state_get client_version)"; csize="$(state_get size)"
    lock_acquire
    mv "$JAR" "$JAR.part" || { lock_release; warn "swap failed"; [ "$was_up" = 1 ] && ( start ); return 1; }
    mv "$JAR_PREV" "$JAR" || { mv "$JAR.part" "$JAR"; lock_release; warn "swap failed"; [ "$was_up" = 1 ] && ( start ); return 1; }
    if ! mv "$JAR.part" "$JAR_PREV"; then
      lock_release
      warn "running jar swapped, but the outgoing jar is left as $(basename "$JAR.part") - move it to $JAR_PREV by hand"
    fi
    # swap the facts the same way the jars swapped, so a second --prev comes back here
    state_write "tag=$ptag" "sha256=$psha" "protocol=$pproto" "client_version=$pclient" "size=${psize:-0}" \
                "prev_tag=$ctag" "prev_sha256=$csha" "prev_protocol=$cproto" \
                "prev_client_version=$cclient" "prev_size=${csize:-0}" \
      || warn "jar swapped but the state file could not be updated - check runtime/bambo.state.json"
    echo "rolled back to the previous jar (PNX $ptag) - no download needed"
  else
    ( setup "$want" ) || { warn "setup failed - server left unchanged"; [ "$was_up" = 1 ] && ( start ); return 1; }
  fi

  notify rollback "server rolled back to PNX $(state_get tag)"
  local cur; cur="$(state_get tag)"
  case "$cur" in
    3.0.3|3.0.4|3.0.5|3.0.6) ;;
    *) echo "note: clients must match Bedrock $(state_get client_version) (protocol $(state_get protocol))" ;;
  esac
  if [ "$was_up" = 1 ]; then echo "restarting server..."; start; else echo "server is stopped - start with 'bambo start' when ready."; fi
}
rollback_menu() {
  [ -t 0 ] || die "rollback menu needs an interactive terminal (use: bambo rollback --list / --prev / <version>)"
  local options=() ans custom i=1 o sel
  [ -f "$JAR_PREV" ] && options+=("prev:Previous installed jar (offline, no download) - PNX $(state_get prev_tag)")
  options+=("3.0.6:PNX 3.0.6 (Bedrock 1.26.60, protocol 2225)")
  options+=("3.0.5:PNX 3.0.5 (Bedrock 1.26.50, protocol 2193)")
  options+=("3.0.4:PNX 3.0.4 (Bedrock 1.26.45, protocol 2169)")
  options+=("3.0.3:PNX 3.0.3 (Bedrock 1.26.44, protocol 2168)")
  echo
  echo "Roll the server back to which version?"
  for o in "${options[@]}"; do echo "  $i) ${o#*:}"; i=$((i+1)); done
  echo "  $i) Another release or client version (e.g. 3.0.2 / 1.26.44)"
  echo "  (Enter) Cancel"
  printf 'Your choice [Enter=cancel]: '
  read -r ans || true
  [ -z "$ans" ] && { echo "cancelled"; return 0; }
  if [[ "$ans" =~ ^[0-9]+$ ]]; then
    if [ "$ans" -ge 1 ] && [ "$ans" -lt "$i" ]; then
      sel="${options[$((ans-1))]}"
      rollback_do "${sel%%:*}"
      return 0
    elif [ "$ans" = "$i" ]; then
      printf 'Tag or client version (e.g. 3.0.2 / 1.26.44): '
      read -r custom || true
      [ -n "$custom" ] && rollback_do "$custom"
      return 0
    fi
  fi
  echo "invalid choice - cancelled"
}
rollback() {
  case "${1:-menu}" in
    menu|--menu) rollback_menu ;;
    list|--list) rollback_list ;;
    prev|--prev) rollback_do --prev ;;
    *) rollback_do "$1" ;;
  esac
}
version() {
  echo "bambo-mc v$BAMBO_VERSION"
  local tag proto client
  tag="$(state_get tag)"; proto="$(state_get protocol)"; client="$(state_get client_version)"
  if [ -n "$tag" ]; then
    echo "server: PNX $tag (protocol $proto, client $client)"
  elif [ -f "$JAR" ]; then
    echo "server: jar present (state not recorded; run 'bambo setup' to pin)"
  else
    echo "server: no jar installed yet (run 'bambo setup')"
  fi
  echo "note : protocol must match your clients; see docs/VERSIONS.md"
}

bootstrap() {
  # One-command fresh-machine setup: dependencies, jar, wrappers, nightly cron,
  # token, dashboard — and optionally the game server (--start).
  # Delegates to the installer; pass --start / --dry-run / --system / --prefix=…
  [ -x "$ROOT/install.sh" ] || die "install.sh missing"
  exec "$ROOT/install.sh" --auto "$@"
}

doctor() {
  echo "== bambo-mc doctor (v$BAMBO_VERSION) =="
  local rc=0
  ok() { echo "  [ok]  $1"; }
  bad() { echo "  [!!]  $1"; rc=1; }
  info() { echo "  [..]  $1"; }

  # system
  command -v java >/dev/null 2>&1 && ok "java found: $(java -version 2>&1 | head -1)" || bad "java not on PATH"
  command -v tmux >/dev/null 2>&1 && ok "tmux found" || bad "tmux missing (required)"
  command -v python3 >/dev/null 2>&1 && ok "python3 found: $(python3 --version 2>&1)" || bad "python3 missing (dashboard/config need it)"
  command -v curl >/dev/null 2>&1 || info "curl missing (only setup needs it)"
  command -v ip >/dev/null 2>&1 || info "ip missing (join/health address lookup may fail)"

  # java 21+
  if command -v java >/dev/null 2>&1; then
    local jv; jv="$(java -version 2>&1 | grep -oE 'version "[0-9]+' | grep -oE '[0-9]+' | head -1)"
    [ "${jv:-0}" -ge 21 ] && ok "java is 21+ ($jv)" || bad "java $jv is < 21 (PNX 3.x needs 21+)"
  fi

  # server state
  if is_up; then
    ok "server RUNNING"
    ss -lun 2>/dev/null | grep -qE ":${PORT}" && ok "UDP $PORT bound" || bad "UDP $PORT NOT bound while running"
  else
    info "server stopped (fine if intentional)"
    port_free && ok "UDP $PORT free" || bad "UDP $PORT is occupied by something else"
  fi
  if [ -f "$JAR" ]; then
    ok "jar present: $(du -sh "$JAR" | cut -f1)"
  else
    bad "server jar missing - run 'bambo setup'"
  fi
  local tag; tag="$(state_get tag)"
  [ -n "$tag" ] && info "pinned: PNX $tag (protocol $(state_get protocol), client $(state_get client_version))" \
                || info "no state recorded yet (run 'bambo setup' to pin)"

  # network
  local ip; ip="$(lan_ip)"
  [ -n "$ip" ] && ok "network address: $ip (network: $(net_name))" || info "no wifi IP detected (laptop not on a hotspot?)"

  # config
  if [ -f "$SRV/pnx.yml" ]; then
    [ -f "$ROOT/server/pnx.yml" ] && config_diff >/dev/null 2>&1 && info "config template present (run 'bambo config diff' to compare)" || info "live config present"
  else
    bad "runtime/pnx.yml missing - server never configured"
  fi

  # backups
  local n; n="$(find "$SRV/backups" -maxdepth 1 -mindepth 1 -type d -name '[0-9][0-9]*' 2>/dev/null | wc -l)"
  info "backups: $n snapshot(s) in runtime/backups (retention ${BAMBO_KEEP:-10})"

  # retention
  local cr; cr="$(crontab -l 2>/dev/null | grep -c 'bambo backup')"
  [ "$cr" -ge 1 ] && ok "nightly backup cron installed" || info "nightly backup cron NOT installed (see README)"

  # dashboard
  if dash_up; then
    ok "dashboard RUNNING http://$DASH_HOST:$DASH_PORT"
  else
    info "dashboard stopped (start with 'bambo dash start')"
  fi
  if [ -f "$ROOT/dash.token" ]; then
    local perm; perm="$(stat -c %a "$ROOT/dash.token")"
    [ "$perm" = "600" ] && ok "dash.token perms 600" || bad "dash.token perms $perm (want 600)"
  else
    info "dash.token not created yet (created on dashboard first run)"
  fi

  echo
  if [ "$rc" = 0 ]; then
    echo "doctor: all clear"
  else
    echo "doctor: issues found (marked [!!]) - address them before going further"
  fi
  return $rc
}
usage() {
  cat <<EOF
bambo (alias: bambo-mc) v$BAMBO_VERSION - control the Bedrock server + admin dashboard

  bambo                     start ALL services (server + dashboard)
  bambo up | down           start / stop all services
  bambo start | stop | restart    game server only (used by the nightly backup cron)
  bambo status              status of server + dashboard
  bambo health [--json]     health summary (JSON for monitoring)
  bambo doctor              self-diagnostics (run this first when something looks wrong)
  bambo version             tool + server version / protocol

  bambo dash [start|stop|status|logs|token-new]   admin dashboard (also: bambo --dash)
  bambo logs [n]            tail the server console (default 60 lines; works stopped too)
  bambo tail                attach to the live server console (Ctrl-B D to detach)
  bambo join                show the current join IP:port
  bambo watch [--once] [--interval=N]   optional watchdog (restarts crashed server)

  bambo players             list players online
  bambo user list|op|deop|whitelist|ban|unban|kick|gamemode   manage players
  bambo op add|del|list <player>       grant / revoke / show operators
  bambo whitelist add|remove|list|on|off|reload <player>
  bambo world list|create|rename|delete|default|save|tp   manage worlds (safe, offline)
  bambo plugins / broadcast <msg> / tps
  bambo motd "<name>" ["<sub>"]   set the server-list name (edits config + restarts)
  bambo cmd <console-command>          run ANY command on the server console
  bambo config init|show|set|apply|wizard|get|diff|apply-template
                             user configuration (bambo.conf) -> server (pnx.yml)
  bambo update check|apply   check upstream PNX version / safely upgrade (backup+install)
  bambo maintenance status|on|off   scheduled daily auto-restart (04:00)
  bambo audit [n]           recent dashboard actions
  bambo docs [README|runbook|security]   open local docs

  bambo backup [--force]    snapshot worlds+players (stop the server first)
  bambo restore list|<ts>   roll worlds back to a snapshot
  bambo setup [version]     download/verify the server jar (pins the deployed version)
  bambo setup --ask           ask: match installed client version, or install latest
  bambo rollback [version|--prev|--list]
                            undo a version change: --prev swaps back to the jar kept
                            on disk (offline, no download); a version re-installs it;
                            no argument opens the version menu
  bambo bootstrap [--start] [--dry-run] [--ask]   automatic fresh-machine setup:
                          deps + jar + wrappers + nightly cron + token (+ server)

  bambo help                this message
  bambo man                 full manual (piped to your pager)

Env: BAMBO_HEAP (1536M) BAMBO_KEEP (10) BAMBO_DASH_HOST/PORT (127.0.0.1:8787) BAMBO_DASH_TOKEN
EOF
}
manpage() {
  local man_text
  man_text="$(cat <<'MAN'
BAMBO(1)                                                             BAMBO(1)

NAME
    bambo / bambo-mc - control a local Minecraft Bedrock (PowerNukkitX) server
    and its admin dashboard, from one command.

SYNOPSIS
    bambo [command ...]
    bambo            # no command = start all services

DESCRIPTION
    bambo wraps one game server (the PNX instance in ./runtime) and a local
    admin dashboard. Bare 'bambo' starts both. 'start'/'stop'/'restart' touch
    ONLY the game server - this is deliberate, the nightly backup cron runs
    'bambo stop && bambo backup && bambo start' and must not disturb the
    dashboard. All mutating operations (start/stop/backup/restore/setup)
    are serialized with a lock, so cron and a human cannot race.

    Deployment facts are pinned in runtime/bambo.state.json (PNX tag, sha256,
    protocol, client version) by 'bambo setup'; 'bambo status'/'health'
    surface them. Snapshots carry a manifest.json and are verified at creation.

COMMANDS
    up / down            start / stop every service
    start / stop / restart   game server only. stop saves worlds and will ask
                             before force-killing a slow shutdown (no tty = it
                             force-kills after a 40s grace, so cron never hangs).
    status               RUNNING/STOPPED for server (with udp/19132 bound?) and dash
    health [--json]      human or machine-readable health (JSON: tool_version, up,
                         dash_up, port_bound, pnx_tag, protocol, client_version, join_ip)
    doctor               diagnostics: system tools, Java 21+, server state, jar,
                         network, config template, backups, cron, dashboard token perms
    version              tool version + pinned server facts
    dash [verb]          start|stop|status|logs|token-new for the dashboard
                         (--dash works too). token-new rotates dash.token atomically.
    logs [n] / tail      console history / live console attach (logs falls back to
                         the server log file when the server is stopped)
    watch [--once] [--interval=N]
                         optional watchdog: restarts a crashed server if it was not
                         intentionally stopped (stop() marks runtime/.bambo.intentional-stop;
                         start() clears it). Logs to logs/watchdog.log.
    join                 prints the live LAN address to type into a client
    players              server 'list' command output
    user list|op|deop|whitelist|ban|unban|kick|gamemode
                         full player management: list online; grant/revoke op;
                         manage the whitelist; ban/unban with reason; kick with
                         reason; set a player's gamemode. (Commands require the
                         server to be running.)
    op add|del|list      operator management (ops.txt / /op)
    whitelist ...        whitelist management (/whitelist)
    world list|create|rename|delete|default|save|tp
                         WORLD MANAGEMENT (offline, safe, reversible):
                         list shows worlds with size and the default marker;
                         create <name> [--template <world>] copies an existing
                         world as a new one; rename <old> <new> also fixes the
                         default pointer; delete <name> [--force] moves the world
                         into runtime/.trash/worlds (NOT hard-deleted; the default
                         world refuses deletion until another default is chosen);
                         default <name> switches the served world (restart applies);
                         save/tp talk to the running server. All mutating world
                         operations require the server to be stopped.
    plugins              list installed plugins (live server)
    broadcast <msg>      send a message to all players (/say)
    tps                 server tick rate / performance (live server)
    update check|apply  check the upstream PNX release against the installed one;
                         apply backs up, installs the verified jar, and restarts
                         only if the server was running.
    maintenance status|on|off
                         scheduled daily auto-restart at 04:00 (cron-managed).
    audit [n]           show recent dashboard actions from logs/dash-audit.log.
    docs [README|runbook|security]
                         print local documentation.
    cmd <text>           send an arbitrary console command (operator pass-through;
                         newlines rejected for safety)
    motd "<name>" ["<sub>"]   set server-list name; edits bambo.conf then deploys and restarts
    config init|show|set|apply|wizard|get|diff|apply-template
                         USER CONFIGURATION lives in bambo.conf (auto-created from
                         config.example; KEY=value, comments welcome). init creates
                         it; show prints effective values; set edits one key safely;
                         apply validates ranges/booleans and deploys to
                         runtime/pnx.yml (--restart restarts the server); wizard
                         prompts interactively (--defaults non-interactive);
                         get/diff query the live pnx.yml and the tracked template;
                         apply-template overwrites the live config from the template.
    backup [--force]     timestamped snapshot of worlds+players+pnx.yml+manifest.json;
                         refuses to copy a RUNNING LevelDB store unless --force.
                         Keeps BAMBO_KEEP (default 10) newest in runtime/backups.
    restore list|<ts>    roll worlds back; keeps the current worlds as
                         worlds.pre-restore-<ts> so the action is reversible.
    setup [version]      fetch the server jar from GitHub, resuming interrupted
                         downloads and verifying the published sha256; records the
                         deployment state. The previous jar is kept as
                         powernukkitx.jar.prev, with its tag/sha256/protocol/client
                         recorded as prev_* in the state, for offline rollback.
                         --ask prompts to install the release matching a detected
                         local client version, or the latest stable.
    rollback [target]    undo a version change (backs up first, swaps the jar, then
                         restarts only if the server was running).
                         --prev     put powernukkitx.jar.prev back in place and swap
                                    the prev_* state keys with it - offline, no
                                    download, and repeatable (a second --prev
                                    returns to the version you left).
                         <version>  re-install a PNX tag or a Bedrock client
                                    version (resolved through the same table setup
                                    uses); needs the network.
                         --list     show the current jar, what --prev would give
                                    back, and the known releases.
                         no argument opens an interactive menu.
    bootstrap [--start] [--dry-run]
                         ONE-COMMAND fresh-machine setup: ensures system deps
                         (apt/dnf/zypper/pacman), the server jar, wrappers, the
                         nightly backup cron, and the dashboard token; installs
                         commands; launches the dashboard (and the server with
                         --start). --dry-run previews without changing anything.

FILES
    runtime/             working dir of the server (jar, pnx.yml, worlds, players)
    runtime/bambo.state.json   pinned deployment facts (tag, sha256, protocol, client)
    dash.token           admin dashboard token (auto-created, chmod 600)
    server/pnx.yml       tracked config template (baseline for config diff/apply)
    logs/                cron/dashboard/watchdog/audit logs

SECURITY
    The dashboard binds 127.0.0.1 by default. 'BAMBO_DASH_HOST=0.0.0.0 bambo dash
    start' exposes 'cmd' to the whole network behind one token - only do
    this on a trusted LAN. Failed auth attempts are rate-limited per IP; every action
    is written to logs/dash-audit.log.

ENVIRONMENT
    BAMBO_HEAP BAMBO_KEEP BAMBO_DASH_HOST BAMBO_DASH_PORT BAMBO_DASH_TOKEN

SEE ALSO  bambo man  |  README.md in the repository  |  docs/RUNBOOK.md
MAN
  )"
  if [ -t 1 ] && command -v less >/dev/null 2>&1; then
    printf '%s\n' "$man_text" | less
  else
    printf '%s\n' "$man_text"
  fi
}
# One command, flag-first: 'bambo --status' and 'bambo status' both work, so the
# nightly cron (./bambo stop && ./bambo backup && ./bambo start) keeps functioning.
main() {
  local a="${1:-}"
  case "$a" in
    "")              up ;;
    -h|-?|help|--help) usage ;;
    --man|man)       manpage ;;
    --version|version) version ;;
    *)
      local verb="${a#--}"; shift                  # --start -> start, args follow
      case "$verb" in
        start)    start ;;
        stop)     stop ;;
        restart)  stop; start ;;
        up)       up ;;
        down|halt) down ;;
        status)   status ;;
        health)   health "${1:-}" ;;
        doctor)   doctor ;;
        version)  version ;;
        dash)     dash "$@" ;;
        logs)     logs "${1:-60}" ;;
        tail)     tmux attach -t "$SESSION" ;;
        join)     join ;;
        watch)    watch "$@" ;;
        players)  players ;;
        user)     user "$@" ;;
        plugins)  plugins ;;
        broadcast|say) broadcast "$@" ;;
        tps)      tps ;;
        update)    update "${1:-check}" ;;
        maintenance) maintenance "${1:-status}" ;;
        audit)     audit "${1:-20}" ;;
        docs)      docs "${1:-README}" ;;
        op)       op "$@" ;;
        whitelist|whl) whitelist "$@" ;;
        world)    world "$@" ;;
        cmd|console|exec) cmd "$@" ;;
        motd|name) motd "$@" ;;
        config)   config "$@" ;;
        bootstrap) bootstrap "$@" ;;
        setup)    case "${1:-}" in --ask) setup_choose ;; --menu) setup_menu ;; *) setup "${1:-}" ;; esac ;;
        rollback) rollback "${1:-}" ;;
        backup)   backup "${1:-}" ;;
        restore)  restore "${1:-list}" ;;
        *)        die "unknown option '$a' - try: bambo --help" ;;
      esac ;;
  esac
}
if [ "${BAMBO_NOEXEC:-0}" != 1 ]; then
  main "$@"
fi
