#!/usr/bin/env bash
# bambo (alias: bambo-mc) - control the Bedrock server + admin dashboard.
#
# This is the single operational entry point for the bambo-mc deployment:
#   services, dashboard, players/op/whitelist/world/cmd/motd/config,
#   backup/restore/setup, doctor/health/watch, help/man.
#
# Run 'bambo help' or 'bambo man' for the manual; bare 'bambo' starts all services.
#
# Production notes (v2):
#   - Locking (flock) prevents concurrent backup/setup/restore races.
#   - runtime/bambo.state.json pins the installed server (tag, sha256, protocol).
#   - Backup snapshots carry a manifest.json and are verified automatically.
#   - 'doctor' is the first thing to run when something looks wrong.
set -uo pipefail

# shellcheck disable=SC2015,SC2012
# - SC2015: helpers ok()/bad()/info() always exit 0 (they only print), so "A && B || C" is safe.
# - SC2012: ls is used deliberately on directories this project owns (backups/worlds).

BAMBO_VERSION="2.6.0"

# cron's default PATH is /usr/bin:/bin, which omits /usr/sbin - where `ip` lives.
# Without this, lan_ip()/join() silently return nothing when run from a cron job.
PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$HOME/.local/bin:$PATH"
export PATH

ROOT="${BAMBO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"

# ---- user configuration (bambo.conf) ----
CONF="$ROOT/bambo.conf"
CONFIG_KEYS="BAMBO_SERVER_NAME BAMBO_SUB_NAME BAMBO_MAX_PLAYERS BAMBO_XBOX_AUTH BAMBO_ALLOWLIST BAMBO_DIFFICULTY BAMBO_GAMEMODE BAMBO_VIEW_DISTANCE BAMBO_PVP BAMBO_ENABLE_METRICS BAMBO_HEAP BAMBO_KEEP BAMBO_DASH_HOST BAMBO_DASH_PORT BAMBO_DASH_TOKEN BAMBO_WEBHOOK_URL"
if [ -f "$CONF" ]; then
  while IFS='=' read -r _k _v; do
    _k="${_k//[[:space:]]/}"
    case "$_k" in
      ""|\#*) continue ;;
    esac
    case " $CONFIG_KEYS " in
      *" $_k "*) ;;
      *) echo "bambo: warning: unknown key in $CONF: $_k" >&2; continue ;;
    esac
    _v="${_v#"${_v%%[![:space:]]*}"}"
    _v="${_v%"${_v##*[![:space:]]}"}"
    if [ -z "${!_k:-}" ]; then
      export "$_k=$_v"
    fi
  done < "$CONF"
  unset _k _v
fi
SRV="$ROOT/runtime"
JAR="$SRV/powernukkitx.jar"
JAR_PREV="$SRV/powernukkitx.jar.prev"
SESSION="bambo-mc"
SESSION_DASH="bambo-dash"
DASH_HOST="${BAMBO_DASH_HOST:-127.0.0.1}"
DASH_PORT="${BAMBO_DASH_PORT:-8787}"
JAVA_HOME_FALLBACK="/usr/lib/jvm/java-21-openjdk-amd64"
HEAP="${BAMBO_HEAP:-1536M}"
PORT=19132
STATE_FILE="$SRV/bambo.state.json"
LOCK_FILE="$SRV/.bambo.lock"
INTENTIONAL_STOP="$SRV/.bambo.intentional-stop"
AUDIT_LOG="$ROOT/logs/dash-audit.log"
WATCHDOG_LOG="$ROOT/logs/watchdog.log"

die() { echo "bambo: $*" >&2; exit 1; }
warn() { echo "bambo: warning: $*" >&2; }

# ---- locking: serialize dangerous ops (start/stop/backup/restore/setup) ----
lock_acquire() {
  local fd
  mkdir -p "$SRV"
  exec {fd}<>"$LOCK_FILE"
  if ! flock -n "$fd"; then
    die "another bambo operation is in progress (lock $LOCK_FILE is held) - retry shortly"
  fi
  LOCK_FD=$fd
}
lock_release() {
  [ -n "${LOCK_FD:-}" ] && flock -u "$LOCK_FD" 2>/dev/null || true
  LOCK_FD=""
}

# ---- state file: pinned, reproducible deployment facts (JSON) ----
state_load() {
  local f="$STATE_FILE"
  if [ -f "$f" ]; then cat "$f"; else echo '{}'; fi
}
state_write() {
  # usage: state_write key=value [key=value ...]
  command -v python3 >/dev/null || { warn "python3 missing - state not recorded"; return 1; }
  ESX_STATE_FILE="$STATE_FILE" python3 - "$@" <<'PY' 2>/dev/null || return 1
import os, json, sys
path = os.environ["ESX_STATE_FILE"]
d = {}
try:
    d = json.load(open(path, encoding="utf-8"))
except Exception:
    pass
for arg in sys.argv[1:]:
    k, _, v = arg.partition("=")
    d[k] = v
tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    json.dump(d, f, indent=2)
    f.write("\n")
os.replace(tmp, path)
PY
}
state_get() {
  local key="$1" f="$STATE_FILE"
  [ -f "$f" ] || { echo ""; return 1; }
  python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1], encoding="utf-8"))
    print(d.get(sys.argv[2], ""))
except Exception:
    pass' "$f" "$key" 2>/dev/null
}

find_java() {
  if java -version 2>&1 | grep -q 'version "2[1-9]'; then command -v java; return; fi
  for c in "$JAVA_HOME_FALLBACK"/bin/java /usr/lib/jvm/*/bin/java; do
    [ -x "$c" ] && "$c" -version 2>&1 | grep -q 'version "2[1-9]' && { echo "$c"; return; }
  done
  die "need Java 21+ (PNX 3.x will not run on older)"
}

lan_ip() {
  local i a
  i="$(ip -o link show type wifi 2>/dev/null | awk -F': ' '{print $2}' | head -1)"
  [ -n "$i" ] || i="$(iw dev 2>/dev/null | awk '/Interface/{print $2; exit}')"
  [ -n "$i" ] || i="wlan0"
  a="$(ip -o -4 addr 2>/dev/null | awk -v ifc="$i" '$2==ifc && $0~/scope global/ {print $4}' | cut -d/ -f1 | head -1)"
  [ -n "$a" ] || a="$(ip -o -4 addr 2>/dev/null | awk '$2!="lo" && $2!~/docker|lxc|br-/ && $0~/scope global/ {print $4}' | cut -d/ -f1 | head -1)"
  echo "$a"
}

net_name() { nmcli -t -f NAME,DEVICE,TYPE connection show --active 2>/dev/null | awk -F: '$3=="802-11-wireless"{print $1; exit}'; }

port_free() { ! ss -lun 2>/dev/null | awk '{print $5}' | grep -qE ":${PORT}$"; }

# ---- console plumbing: the shared backend for players/op/whitelist/world/cmd ----
is_up() { tmux has-session -t "$SESSION" 2>/dev/null; }
dash_up() { tmux has-session -t "$SESSION_DASH" 2>/dev/null; }

console() {
  is_up || die "server not running - start it first (bambo start)"
  tmux send-keys -t "$SESSION" "$*" C-m
  echo "sent to console: $*"
}

_pane_lines() { tmux capture-pane -pt "$SESSION" -S -2000 2>/dev/null | grep -cvE '^[[:space:]]*$'; }

console_out() {
  is_up || die "server not running - start it first (bambo start)"
  local mark base n quiet=0 grew=0 i all mark_line reply
  mark="$(_pane_lines)"; base="$mark"
  tmux send-keys -t "$SESSION" "$*" C-m
  # Wait for the console's OWN reply instead of a fixed 0.8s nap: while the server
  # was busy the nap always showed the PREVIOUS command's output, so tps, players
  # and plugins reported stale lines. Echoing the command adds one line, so growth
  # past mark+1 means an answer has begun; return once the answer stops growing.
  for i in $(seq 1 100); do
    sleep 0.25
    n="$(_pane_lines)"
    if [ "$n" -gt "$base" ]; then
      base="$n"; quiet=0
      [ "$n" -gt "$((mark + 1))" ] && grew=1
    elif [ "$grew" = 1 ]; then
      quiet=$((quiet + 1))
      [ "$quiet" -ge 6 ] && break
    fi
  done
  # Print only what followed THIS command - a fixed tail -18 still leaked the
  # previous block whenever two actions ran back to back.
  all="$(tmux capture-pane -pt "$SESSION" -S -2000 2>/dev/null | grep -vE '^[[:space:]]*$')"
  mark_line="$(printf '%s\n' "$all" | grep -n -F "> $*" | tail -1 | cut -d: -f1)"
  if [ -n "$mark_line" ]; then
    reply="$(printf '%s\n' "$all" | tail -n +"$((mark_line + 1))" | grep -vE '^>[[:space:]]*$')"
    [ -n "$reply" ] && { printf '%s\n' "$reply" | tail -25; return 0; }
  fi
  printf '%s\n' "$all" | tail -18
}
start() {
  [ -f "$JAR" ] || die "missing $JAR - run ./bambo setup first"
  tmux has-session -t "$SESSION" 2>/dev/null && { echo "server already running:"; status; return 0; }
  port_free || die "UDP $PORT is busy - another Bedrock server is holding it"
  local jvm; jvm="$(find_java)"
  lock_acquire
  # starting is an explicit act: clear the intentional-stop marker so the watchdog
  # treats subsequent crashes as genuine failures (and restarts them).
  rm -f "$INTENTIONAL_STOP"
  cd "$SRV" || die "missing $SRV"
  tmux new-session -d -s "$SESSION" \
    "\"$jvm\" -Xms${HEAP} -Xmx${HEAP} -XX:+UseG1GC -XX:MaxGCPauseMillis=50 -XX:+ShowCodeDetailsInExceptionMessages -jar powernukkitx.jar" \
    2>/dev/null || { lock_release; die "could not start detached"; }
  echo "starting (first boot generates worlds, allow ~60s)..."
  local ok=""
  for _ in $(seq 1 90); do
    tmux has-session -t "$SESSION" 2>/dev/null || break
    if ss -lun 2>/dev/null | grep -qE ":${PORT}"; then ok=1; break; fi
    sleep 1
  done
  lock_release
  if [ -n "$ok" ]; then
    echo "READY - listening on UDP $PORT"
    notify start "server ready on UDP $PORT"
  elif tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "still booting; watch with ./bambo tail"
  else
    echo "FAILED - process exited immediately."
    # tmux is already gone, so capture-pane yields nothing; fall back to the log file
    local lg; lg="$SRV/logs/server.log"
    if [ -f "$lg" ]; then
      echo "  last lines of $lg:"; tail -12 "$lg" | sed 's/^/    /'
    else
      echo "  no log file yet - run it in the foreground to see the error:"
      echo "    cd $SRV && java -Xmx${HEAP} -jar powernukkitx.jar"
    fi
    die "server did not stay up"
  fi
  join
}

stop() {
  tmux has-session -t "$SESSION" 2>/dev/null || { echo "server not running"; rm -f "$INTENTIONAL_STOP"; return 0; }
  lock_acquire
  tmux send-keys -t "$SESSION" 'stop' C-m 2>/dev/null
  local i=0
  while [ $i -lt 40 ]; do
    tmux has-session -t "$SESSION" 2>/dev/null || {
      echo "stopped cleanly"; touch "$INTENTIONAL_STOP"; notify stop "server stopped cleanly"; lock_release; return 0; }
    sleep 1; i=$((i+1))
  done
  # World saves can take a while on a slow disk; killing early risks losing chunk edits.
  echo "still shutting down after ${i}s - it may be saving worlds."
  if [ ! -e /proc/self/fd/0 ] || ! read -r -p "force kill now? [y/N] " a < /dev/tty 2>/dev/null; then
    # No terminal (cron/systemd): waiting forever would leave the port held and
    # make ./bambo backup refuse. We already gave it 40s to save.
    echo "  no terminal available (cron?) - forcing stop after ${i}s grace"
    tmux kill-session -t "$SESSION" 2>/dev/null; echo "stopped (forced)"
    notify stop "server stopped (forced after grace)"
  elif [ "$a" = "y" ] || [ "$a" = "Y" ]; then
    tmux kill-session -t "$SESSION" 2>/dev/null; echo "killed"
  else
    echo "left running; check ./bambo status in a moment"
    lock_release
    return 0
  fi
  touch "$INTENTIONAL_STOP"
  lock_release
}
status() {
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    local b; b="$(ss -lun 2>/dev/null | grep -qE ":${PORT}" && echo bound || echo 'not bound yet')"
    echo "server : RUNNING  (udp/$PORT $b)"
  else
    echo "server : STOPPED"
  fi
  if tmux has-session -t "$SESSION_DASH" 2>/dev/null; then
    echo "dash   : RUNNING  http://$DASH_HOST:$DASH_PORT"
  else
    echo "dash   : STOPPED"
  fi
  local tag; tag="$(state_get tag)"
  [ -n "$tag" ] && echo "install : PNX $tag   (state: $STATE_FILE)" || true
}

status_json() {
  # machine-readable status for tooling; emits one JSON object.
  local up="false" dup="false" bound="false"
  is_up && up="true"
  dash_up && dup="true"
  ss -lun 2>/dev/null | grep -qE ":${PORT}" && bound="true"
  local tag proto client ip bc dfree
  tag="$(state_get tag)"; proto="$(state_get protocol)"; client="$(state_get client_version)"
  ip="$(lan_ip)"
  bc="$(find "$SRV/backups" -maxdepth 1 -mindepth 1 -type d -name '[0-9][0-9]*' 2>/dev/null | wc -l)"
  dfree="$(df -P "$ROOT" 2>/dev/null | awk 'NR==2{print $4}')"
  dfree="${dfree:-0}"
  printf '{"tool_version":"%s","up":%s,"dash_up":%s,"port_bound":%s,"pnx_tag":"%s","protocol":"%s","client_version":"%s","join_ip":"%s","backups":%s,"disk_free_kb":"%s"}\n' \
    "$BAMBO_VERSION" "$up" "$dup" "$bound" "$tag" "$proto" "$client" "$ip" "$bc" "$dfree"
}

health() {
  local want_json="${1:-}"
  if [ "$want_json" = "--json" ]; then
    status_json
    return 0
  fi
  echo "== bambo-mc health (v$BAMBO_VERSION) =="
  status
  local tag; tag="$(state_get tag)"
  if [ -n "$tag" ]; then
    echo "  server pin : PNX $tag  protocol $(state_get protocol)  client $(state_get client_version)"
  else
    echo "  server pin : (none recorded - run ./bambo setup to record)"
  fi
  echo "  join       : $(lan_ip):$PORT  network: $(net_name)"
  local n; n="$(find "$SRV/backups" -maxdepth 1 -mindepth 1 -type d -name '[0-9][0-9]*' 2>/dev/null | wc -l)"
  echo "  backups    : $n snapshot(s) (retention ${BAMBO_KEEP:-10})"
  echo "  disk       : $(df -h "$ROOT" | awk 'NR==2{print $4" free of "$2" ("$5" used)"}')"
  local cr; cr="$(crontab -l 2>/dev/null | grep -c 'bambo backup')"
  echo "  cron backup : $([ "$cr" -ge 1 ] && echo installed || echo MISSING)"
}

join() {
  local ip n; ip="$(lan_ip)"; n="$(net_name)"
  echo "network: ${n:-unknown}    (re-run this if you switch WiFi or the lease changes)"
  echo "Bedrock clients - Servers -> Add Server:"
  echo "  address  ${ip:-<no network>}    port  $PORT"
  echo "  (this machine only: 127.0.0.1)"
}

logs() {
  local n="${1:-60}"
  n="${n//[^0-9]/}"
  [ -n "$n" ] || n=60
  if is_up; then
    tmux capture-pane -pt "$SESSION" -S -"$n" 2>/dev/null || die "not running"
  else
    local lg="$SRV/logs/server.log"
    if [ -f "$lg" ]; then
      echo "(server stopped - showing last $n lines of $lg)"
      tail -n "$n" "$lg"
    else
      echo "(server stopped, no log file yet)"
    fi
  fi
}

watch() {
  # Opt-in watchdog: restarts the server if it dies while it was supposed to be up.
  # 'start' clears the intentional-stop marker; 'stop' sets it. If the marker is
  # present, the server is considered intentionally down and the watchdog stays quiet.
  local once="${1:-}" interval="${2:-15}"
  case "$once" in
    --once) once=1 ;;
    *) once=0 ;;
  esac
  case "$interval" in
    --interval=*) interval="${interval#--interval=}" ;;
  esac
  [[ "$interval" =~ ^[0-9]+$ ]] || interval=15
  [ "$interval" -ge 5 ] || interval=5
  command -v tmux >/dev/null || die "tmux required"
  mkdir -p "$(dirname "$WATCHDOG_LOG")"
  echo "$(date -Is) watchdog started (interval ${interval}s, once=$once)" >> "$WATCHDOG_LOG"
  local restarts=0
  while :; do
    if ! is_up; then
      if [ -f "$INTENTIONAL_STOP" ]; then
        [ "$once" = 1 ] && { echo "server intentionally stopped; exiting"; break; }
      elif [ -f "$JAR" ]; then
        restarts=$((restarts+1))
        echo "$(date -Is) SERVER DOWN - restarting (attempt #$restarts)" >> "$WATCHDOG_LOG"
        notify crash "server was down; restart attempted (#$restarts)"
        start >/dev/null 2>&1 || echo "$(date -Is) restart FAILED" >> "$WATCHDOG_LOG"
      else
        echo "$(date -Is) jar missing - nothing to restart" >> "$WATCHDOG_LOG"
        [ "$once" = 1 ] && break
      fi
    fi
    if [ "$once" = 1 ]; then
      if is_up; then
        echo "health check done (server up)"
      else
        echo "health check done (server down)"
      fi
      break
    fi
    sleep "$interval"
  done
}
# ---- services: server + dashboard ----
up() {
  start
  dash_start
}
down() { stop; dash_stop; }

dash_start() {
  dash_up && { echo "dashboard already running: http://$DASH_HOST:$DASH_PORT"; return 0; }
  command -v python3 >/dev/null || die "python3 not found - needed for the dashboard"
  [ -f "$ROOT/bin/bambo-dash.py" ] || die "dashboard script not found: $ROOT/bin/bambo-dash.py"
  tmux new-session -d -s "$SESSION_DASH" \
    "python3 \"$ROOT/bin/bambo-dash.py\" --host \"$DASH_HOST\" --port \"$DASH_PORT\"" \
    2>/dev/null || die "could not start dashboard"
  sleep 1
  dash_up || die "dashboard failed to start (see logs/dash.log)"
  echo "dashboard up: http://$DASH_HOST:$DASH_PORT"
  if [ -n "${BAMBO_DASH_TOKEN:-}" ]; then
    echo "  token: (from BAMBO_DASH_TOKEN env)"
  elif [ -f "$ROOT/dash.token" ]; then
    echo "  token: $(cat "$ROOT/dash.token")"
  else
    echo "  token: <generated on first request>"
  fi
  echo "  stop:  bambo dash stop   logs: bambo dash logs   rotate: bambo dash token-new"
}
dash_stop() {
  dash_up || { echo "dashboard not running"; return 0; }
  tmux kill-session -t "$SESSION_DASH" 2>/dev/null; echo "dashboard stopped"
}
dash_token_new() {
  command -v python3 >/dev/null || die "python3 required"
  python3 - <<'PY'
import os, secrets, sys
p = os.path.join(os.path.dirname(os.path.abspath(__file__)), "dash.token")
tmp = p + ".tmp"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    f.write(secrets.token_hex(32) + "\n")
os.replace(tmp, p)
print("new token written to %s" % p)
PY
}
dash() {
  case "${1:-start}" in
    start)  dash_start ;;
    stop)   dash_stop ;;
    status) dash_up && echo "dashboard RUNNING http://$DASH_HOST:$DASH_PORT" || echo "dashboard STOPPED" ;;
    logs)   tmux capture-pane -pt "$SESSION_DASH" -S -60 2>/dev/null || { echo "(no live pane; latest dashboard log:)"; tail -30 "$ROOT/logs/dash.log" 2>/dev/null || die "dashboard not running"; } ;;
    token-new|rotate) dash_token_new ;;
    *)      die "dash: use start|stop|status|logs|token-new" ;;
  esac
}
players() { console_out "list"; }

op() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    add)         [ $# -ge 1 ] || die "usage: bambo op add <player>"; console "/op $*" ;;
    del|rm|remove) [ $# -ge 1 ] || die "usage: bambo op del <player>"; console "/deop $*" ;;
    list|ls)     echo "--- runtime/ops.txt ---"; cat "$SRV/ops.txt" 2>/dev/null || echo "(empty)" ;;
    *)           die "op: use add|del|list" ;;
  esac
}

whitelist() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    add)         [ $# -ge 1 ] || die "usage: bambo whitelist add <player>"; console "/whitelist add $*" ;;
    del|rm|remove) [ $# -ge 1 ] || die "usage: bambo whitelist remove <player>"; console "/whitelist remove $*" ;;
    on)          console "/whitelist on" ;;
    off)         console "/whitelist off" ;;
    list)        console_out "/whitelist list" ;;
    reload)      console "/whitelist reload" ;;
    *)           die "whitelist: use add|remove|list|on|off|reload" ;;
  esac
}

WORLD_NAME_RE='^[A-Za-z0-9_-]+$'

default_world() {
  grep -E '^\s*defaultLevelName\s*:' "$SRV/pnx.yml" 2>/dev/null | sed 's/.*: *//' | tr -d '"'
}
world_exists() { [ -d "$SRV/worlds/$1" ]; }
world_require_stopped() { is_up && die "server is running - stop it first (bambo stop)"; }

world_list() {
  local d dir def
  def="$(default_world)"
  local any=0
  for dir in "$SRV/worlds"/*/; do
    [ -d "$dir" ] || continue
    any=1
    d="$(basename "$dir")"
    if [ "$d" = "$def" ]; then
      printf '  %-24s %6s  %s\n' "$d" "$(du -sh "$dir" | cut -f1)" "(default)"
    else
      printf '  %-24s %6s\n' "$d" "$(du -sh "$dir" | cut -f1)"
    fi
  done
  [ "$any" = 0 ] && echo "  (no worlds yet - run the server once to generate the default world)" || true
}
world_create() {
  local name="${1:-}" tmpl="${2:-world}"
  [[ "$name" =~ $WORLD_NAME_RE ]] || die "world create: invalid name '$name' (letters/digits/_/- only)"
  lock_acquire; world_require_stopped
  world_exists "$name" && { lock_release; die "world '$name' already exists"; }
  world_exists "$tmpl" || { lock_release; die "template world '$tmpl' not found (use an existing world as template)"; }
  cp -a "$SRV/worlds/$tmpl" "$SRV/worlds/$name" || { lock_release; die "copy failed"; }
  lock_release
  echo "created world '$name' (copied from '$tmpl')"
  echo "next:  bambo world default $name   &&   bambo restart"
}
world_rename() {
  local old="${1:-}" new="${2:-}"
  [[ "$old" =~ $WORLD_NAME_RE ]] && [[ "$new" =~ $WORLD_NAME_RE ]] || die "world rename: invalid name(s) (letters/digits/_/- only)"
  lock_acquire; world_require_stopped
  world_exists "$old" || { lock_release; die "world '$old' not found"; }
  world_exists "$new" && { lock_release; die "world '$new' already exists"; }
  mv "$SRV/worlds/$old" "$SRV/worlds/$new" || { lock_release; die "rename failed"; }
  if [ "$(default_world)" = "$old" ]; then
    config_edit "$SRV/pnx.yml" defaultLevelName "$new" || { lock_release; die "renamed world but failed to update defaultLevelName - fix manually"; }
    echo "  default world pointer updated to '$new'"
  fi
  lock_release
  echo "renamed world '$old' -> '$new'"
}
world_delete() {
  local name="${1:-}" force="${2:-}" stamp
  [[ "$name" =~ $WORLD_NAME_RE ]] || die "world delete: invalid name"
  lock_acquire; world_require_stopped
  world_exists "$name" || { lock_release; die "world '$name' not found"; }
  if [ "$(default_world)" = "$name" ] && [ "$force" != "--force" ]; then
    lock_release
    die "world '$name' is the DEFAULT world - switch default first (bambo world default <other>) or pass --force"
  fi
  mkdir -p "$SRV/.trash/worlds"
  stamp="$(date +%Y%m%d-%H%M%S)"
  mv "$SRV/worlds/$name" "$SRV/.trash/worlds/$stamp-$name" || { lock_release; die "move to trash failed"; }
  lock_release
  echo "world '$name' moved to runtime/.trash/worlds/$stamp-$name"
  echo "restore: mv runtime/.trash/worlds/$stamp-$name runtime/worlds/$name"
  echo "permanent delete: rm -rf runtime/.trash/worlds/$stamp-$name"
}
world_default() {
  local name="${1:-}"
  [[ "$name" =~ $WORLD_NAME_RE ]] || die "world default: invalid name"
  world_exists "$name" || die "world '$name' not found"
  config_edit "$SRV/pnx.yml" defaultLevelName "$name" || die "failed to set defaultLevelName"
  echo "default world -> '$name'"
  if is_up; then
    echo "restart required to take effect: bambo restart"
  fi
}

world() {
